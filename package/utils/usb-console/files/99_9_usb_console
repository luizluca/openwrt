# As hotplug.json is not working, launch a shell here

usb_serial_shell() {
	local consoles="$(cat /sys/class/tty/console/active)"
	[ -n "$consoles" ] || consoles=console
	for console in $consoles; do
		case "$console" in
			ttyUSB[0-9]*)
				term=${TERM:-linux}
				;;
			*)
				continue;
				;;
		esac
		# Running asynchronously via the shell's & would ignore SIGINT,
		# breaking ^C. Use start-stop-daemon instead.
		[ -c "/dev/$console" ] && start-stop-daemon -Sb -p /dev/null -- env -i ash -c "while true; do setsid -c env -i USER=root LOGNAME=root SHELL=/bin/ash TERM=\"$term\" /sbin/askfirst ash -c '[ \"\$(uci -q get system.@system[0].ttylogin)\" = 1 ] || exec /bin/login -f root; exec /bin/login'; sleep 1; done <\"/dev/$console\" >\"/dev/$console\" 2>&1"
	done

}

boot_hook_add preinit_main usb_serial_shell
