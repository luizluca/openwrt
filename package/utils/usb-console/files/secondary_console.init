#!/bin/sh /etc/rc.common

START=99

boot() {
    local consoles="$(cat /sys/class/tty/console/active 2>/dev/null)"
    
    local primary="${consoles##* }"
    for dev in $consoles; do
        [ "$dev" = "$primary" ] && continue
        
        [ -c "/dev/$dev" ] || continue
        
	case "$dev" in
            console|tty[0-9]*) term=${TERM:-linux} ;;
            *)                 term=vt102 ;;
        esac

        logger -t secondary-console "Starting /sbin/askfirst for /dev/$dev..."

	start-stop-daemon -Sb -p /dev/null -- env -i ash -c \
            "while true; do setsid -c env -i USER=root LOGNAME=root SHELL=/bin/ash TERM=\"$term\" /sbin/askfirst ash -c '[ \"\$(uci -q get system.@system[0].ttylogin)\" = 1 ] || exec /bin/login -f root; exec /bin/login' <\"/dev/$dev\" >\"/dev/$dev\" 2>&1; sleep 1; done"
    done
}
