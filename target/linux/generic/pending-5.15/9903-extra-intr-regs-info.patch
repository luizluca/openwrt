From 64a402da99b24d1c1d738e255c675051a00ee25d Mon Sep 17 00:00:00 2001
From: Luiz Angelo Daros de Luca <luizluca@gmail.com>
Date: Sat, 29 Jan 2022 13:27:55 -0300
Subject: [PATCH 9903/9908] extra intr regs info

Signed-off-by: Luiz Angelo Daros de Luca <luizluca@gmail.com>
---
 drivers/net/dsa/realtek/rtl8365mb.c | 23 +++++++++++++++++++++++
 1 file changed, 23 insertions(+)

diff --git a/drivers/net/dsa/realtek/rtl8365mb.c b/drivers/net/dsa/realtek/rtl8365mb.c
index 3d70e8a77ecf..7bec858e01e5 100644
--- a/drivers/net/dsa/realtek/rtl8365mb.c
+++ b/drivers/net/dsa/realtek/rtl8365mb.c
@@ -171,12 +171,35 @@ static const int rtl8365mb_extint_port_map[]  = { -1, -1, -1, -1, -1, -1, 1, 2,
 		 RTL8365MB_INTR_LINK_CHANGE_MASK)
 
 /* Per-port interrupt type status registers */
+#define RTL8365MB_LEARN_OVER_IND_REG		0x1103
+#define    RTL8365MB_LEARN_OVER_IND_MASK	0x07FF
+
+#define RTL8365MB_SPEED_CHANGE_IND_REG		0x1104
+#define   RTL8365MB_SPEED_CHANGE_IND_MASK	0x07FF
+
+#define RTL8365MB_SPECIAL_CONGEST_IND_REG	0x1105
+#define   RTL8365MB_SPECIAL_CONGEST_IND_MASK	0x07FF
+
 #define RTL8365MB_PORT_LINKDOWN_IND_REG		0x1106
 #define   RTL8365MB_PORT_LINKDOWN_IND_MASK	0x07FF
 
 #define RTL8365MB_PORT_LINKUP_IND_REG		0x1107
 #define   RTL8365MB_PORT_LINKUP_IND_MASK	0x07FF
 
+/* not per-port */
+#define RTL8365MB_SYSTEM_LEARN_OVER_IND_REG	0x1108
+#define   RTL8365MB_SYSTEM_LEARN_OVER_IND_MASK	0x1
+
+/* not per-port */
+#define RTL8365MB_METER_OVER0_IND_REG		0x1702
+#define RTL8365MB_METER_OVER1_IND_REG		0x1703
+
+#define RTL8365MB_RLDP_LOOPED_IND_REG		0x18EB
+#define   RTL8365MB_RLDP_LOOPED_IND_MASK	0x07FF
+
+#define RTL8365MB_RLDP_RELEASED_IND_REG		0x18EC
+#define   RTL8365MB_RLDP_RELEASED_IND_MASK	0x07FF
+
 /* PHY indirect access registers */
 #define RTL8365MB_INDIRECT_ACCESS_CTRL_REG			0x1F00
 #define   RTL8365MB_INDIRECT_ACCESS_CTRL_RW_MASK		0x0002
-- 
