+	const struct rtl8365mb_port_desc *ports_desc;
 };
 
+static inline int rtl8365mb_port_valid(struct realtek_priv *priv, int port)
+{
+	struct rtl8365mb *mb = priv->chip_data;
+
+	if (port < 0)
+		return 0;
+
+	if (port >= RTL8365MB_MAX_NUM_PORTS)
+		return 0;
+
+	switch (mb->ports_desc[port].type) {
+	case RTL8365MB_USER_PORT:
+	case RTL8365MB_EXTINT1_PORT:
+	case RTL8365MB_EXTINT2_PORT:
+		return 1;
+	}
+
+	return 0;
+}
+
+static inline int rtl8365mb_extint_port(struct realtek_priv *priv, int port)
+{
+	struct rtl8365mb *mb = priv->chip_data;
+
+	if (!rtl8365mb_port_valid(priv, port))
+		return -1;
+
+	switch (mb->ports_desc[port].type) {
+	case RTL8365MB_EXTINT1_PORT:
+		return 1;
+	case RTL8365MB_EXTINT2_PORT:
+		return 2;
+	}
+	return -1;
+}
