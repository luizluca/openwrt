. /lib/functions.sh
. /lib/functions/uci-defaults.sh

board_config_update

case "$(board_name)" in
	tplink,archer-a7-v5|\
	tplink,archer-c7-v4|\
	tplink,archer-c7-v5|\
	tplink,tl-wdr3600-v1|\
	tplink,tl-wdr4300-v1|\
	tplink,tl-wdr4300-v1-il|\
	tplink,tl-wr1043nd-v1)
		ucidef_set_compat_version "1.1"
	;;
esac

board_config_flush

exit 0
